# Whether to include magnet links in the mcp.search_torrents()/mcp.popular_torrents() results (thepiratebay.org, nyaa.si, 1337x.to, yts.mx, apibay.org, eztvx.to, fitgirl-repacks.site, subsplease.org, bittorrented.com, uindex.org).
# If unset, defaults to 'false' to greatly reduce token usage.
#INCLUDE_LINKS=true

# Comma-separated list of sources to exclude from the mcp.search_torrents() results.
#EXCLUDE_SOURCES=nyaa.si

# Seconds of inactivity before the headless browser used for HTML sources is
# shut down (it restarts automatically on the next search). Default: 120.
#CRAWLER_IDLE_TIMEOUT=120

# MCP only: point the MCP tools at a running Torrent Search REST API
# (e.g. http://localhost:8000) instead of scraping locally. Unset = standalone.
#TORRENT_SEARCH_API_URL=http://localhost:8000

# Telegram bot handle used by the Web UI torrent action. Unset = hidden.
#TELEGRAM_BOT_HANDLE=
# Synology Download Station: adds a one-click "Download on NAS" button to the
# Web UI that queues the magnet link on your NAS. Unset SYNOLOGY_URL = hidden.
# Use a dedicated DSM account without 2-factor auth, allowed to use Download Station.
#SYNOLOGY_URL=https://192.168.1.10:5001
#SYNOLOGY_USERNAME=downloader
#SYNOLOGY_PASSWORD=
# Optional shared-folder path (no leading slash); default = Download Station's default folder.
#SYNOLOGY_DESTINATION=downloads/torrents
# Set to false if the NAS uses a self-signed HTTPS certificate.
#SYNOLOGY_VERIFY_SSL=true

# Download folder as seen by this app (a local path, or the container mount
# point). Enables the Downloads view's file list and "delete files" option.
# For the NAS container setup see deploy/synology/.
#LIBRARY_DIR=/downloads
