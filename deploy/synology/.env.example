# Copy to .env next to compose.yaml on the NAS and fill in.

# ---- Synology Download Station ----------------------------------------------
# DSM as seen from inside the container. DSM's own certificate won't match this
# name, so certificate checks are turned off (traffic never leaves the NAS).
SYNOLOGY_URL=https://host.docker.internal:5001
SYNOLOGY_VERIFY_SSL=false
# Dedicated DSM user with Download Station access only, no 2-factor auth.
SYNOLOGY_USERNAME=torrent-bot
SYNOLOGY_PASSWORD=
# Shared folder + subfolder Download Station saves into, no leading slash.
# Must be the same folder that DOWNLOADS_PATH mounts.
SYNOLOGY_DESTINATION=downloads

# ---- Container ----------------------------------------------------------------
# Absolute NAS path of SYNOLOGY_DESTINATION (usually /volume1/<shared folder>/...).
DOWNLOADS_PATH=/volume1/downloads
# Top-level folders in the download folder the web page must never show or
# delete (comma-separated, case-insensitive), e.g. existing Plex libraries.
LIBRARY_PROTECT=movies,series
# Port for the web UI: http://<nas-ip>:8000
WEB_PORT=8000

# ---- Optional -------------------------------------------------------------------
#TELEGRAM_BOT_HANDLE=
#EXCLUDE_SOURCES=

# ---- Redeploy (redeploy.sh only) -------------------------------------------
# SSH login (admin account with key auth) used to push updates.
#NAS_SSH=admin-user@192.168.1.10
